rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /torneios/{torneioId} {
      allow read, write: if request.auth != null && request.auth.token.torneioId == torneioId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.token.torneioId == torneioId;
      }
    }
  }
}
